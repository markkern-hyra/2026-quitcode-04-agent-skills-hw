# LeadDesk local settings. Copy this file to .env.local and adjust it there.
# .env* files are git-ignored (except this example), so real values never reach git.

# n8n (contract: .claude/skills/integrating-n8n-webhooks) - server-only variables; real values
# live only in .env.local and in the hosting settings. Generate secrets with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Events and their webhooks: docs/n8n-integrations.md.
# Base of the production webhook URLs, ends with /webhook. Locally it points at the offline mock:
#   node --env-file=.env.local .claude/skills/integrating-n8n-webhooks/scripts/mock-n8n.mjs --mode respond-202
N8N_WEBHOOK_BASE_URL=http://127.0.0.1:5678/webhook
# Header Auth value (header x-n8n-token) = the Header Auth credential in n8n.
N8N_WEBHOOK_TOKEN=change-me-webhook-token
# HMAC secret of callbacks = Hmac Secret of the Crypto credential in n8n.
N8N_CALLBACK_SECRET=change-me-callback-secret
# Where n8n reaches this app's callbacks (/api/n8n/<event>).
APP_BASE_URL=http://127.0.0.1:3000

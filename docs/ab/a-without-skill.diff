diff --git a/lib/quote-callback.ts b/lib/quote-callback.ts
new file mode 100644
index 0000000..c0dea9d
--- /dev/null
+++ b/lib/quote-callback.ts
@@ -0,0 +1,25 @@
+import { createHash, randomBytes, timingSafeEqual } from "node:crypto";
+
+// Every quote request gets its own callback token: n8n receives it in the
+// webhook payload and sends it back as a Bearer token. A leaked token can only
+// touch its own quote, and the store keeps just the hash.
+
+function hashToken(token: string) {
+  return createHash("sha256").update(token).digest("hex");
+}
+
+export function createCallbackToken() {
+  const token = randomBytes(32).toString("base64url");
+  return { token, hash: hashToken(token) };
+}
+
+export function verifyCallbackToken(token: string, expectedHash: string) {
+  // Both sides are sha256 hex digests, so the buffers always have equal length.
+  return timingSafeEqual(Buffer.from(hashToken(token), "hex"), Buffer.from(expectedHash, "hex"));
+}
+
+// Base URL n8n uses to reach us. Taken from config, never from the request's
+// Host header: otherwise a forged Host would make n8n POST wherever it points.
+export function callbackUrl(quoteId: string) {
+  return new URL(`/api/quotes/${quoteId}/callback`, process.env.APP_URL).href;
+}

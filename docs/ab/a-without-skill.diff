+"use server";
+
+import { redirect } from "next/navigation";
+import { db } from "@/lib/db";
+import { callbackUrl, createCallbackToken } from "@/lib/quote-callback";
+import { parseQuoteForm, type QuoteFormField, type QuoteFormValues } from "@/lib/quote-form";
+
+// The quote-request workflow runs 40–90 s, so we only wait for n8n to accept
+// the job (its Webhook node must respond immediately). The PDF arrives later
+// via /api/quotes/[id]/callback.
+const WEBHOOK_ACK_TIMEOUT_MS = 10_000;
+
+export type RequestQuoteState =
+  | { status: "idle" }
+  | { status: "invalid"; errors: Partial<Record<QuoteFormField, string>>; values: QuoteFormValues };
+
+export async function requestQuote(
+  _prevState: RequestQuoteState,
+  formData: FormData,
+): Promise<RequestQuoteState> {
+  const parsed = parseQuoteForm(formData);
+  if (!parsed.ok) {
+    return { status: "invalid", errors: parsed.errors, values: parsed.values };
+  }
+
+  const callbackToken = createCallbackToken();
+  const quote = await db.insertQuote({ ...parsed.data, callbackTokenHash: callbackToken.hash });
+
+  try {
+    const response = await fetch(process.env.N8N_QUOTE_WEBHOOK_URL!, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        quoteId: quote.id,
+        ...parsed.data,
+        callback: { url: callbackUrl(quote.id), token: callbackToken.token },
+      }),
+      signal: AbortSignal.timeout(WEBHOOK_ACK_TIMEOUT_MS),
+    });
+    if (!response.ok) throw new Error(`n8n responded with ${response.status}`);
+  } catch (error) {
+    console.error(`Failed to start quote-request workflow for ${quote.id}`, error);
+    await db.settleQuote(quote.id, { status: "failed", failureReason: "workflow did not start" });
+  }
+
+  redirect(`/quotes/${quote.id}`);
+}

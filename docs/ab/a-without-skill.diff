+  // The id in the URL is the only key to this page: keep it out of search engines.
+  robots: { index: false, follow: false },
+};
+
+const POLL_INTERVAL_MS = 5000;
+// The workflow takes 40–90 s. Past this point we stop polling and say it is late.
+const LATE_AFTER_MS = 5 * 60 * 1000;
+
+const dateTimeFormat = new Intl.DateTimeFormat("uk-UA", { dateStyle: "medium", timeStyle: "short" });
+
+function budgetLabel(budget: number | null) {
+  const value = budget === null ? "" : String(budget);
+  return BUDGET_OPTIONS.find((option) => option.value === value)?.label ?? "—";
+}
+
+function isLate(quote: QuoteRequest) {
+  return quote.status === "processing" && Date.now() - Date.parse(quote.createdAt) > LATE_AFTER_MS;
+}
+
+export default async function QuotePage({ params }: PageProps<"/quotes/[id]">) {
+  const { id } = await params;

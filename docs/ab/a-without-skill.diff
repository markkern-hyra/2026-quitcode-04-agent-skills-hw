+import { db } from "@/lib/db";
+import { verifyCallbackToken } from "@/lib/quote-callback";
+import type { QuoteResult } from "@/lib/types";
+
+// Called by the n8n quote-request workflow when it finishes:
+//
+//   POST /api/quotes/<quoteId>/callback
+//   Authorization: Bearer <callback.token from the webhook payload>
+//   { "status": "ready", "pdfUrl": "https://…" }  or  { "status": "failed", "error": "…" }
+
+const MAX_BODY_LENGTH = 10_000;
+
+function isAllowedPdfUrl(value: string) {
+  let url: URL;
+  try {
+    url = new URL(value);
+  } catch {
+    return false;
+  }
+  // The URL ends up in an <a href>, so anything like javascript: is rejected.
+  return url.protocol === "https:" || (process.env.NODE_ENV !== "production" && url.protocol === "http:");
+}
+
+function parseResult(body: unknown): QuoteResult | null {
+  if (typeof body !== "object" || body === null) return null;
+  const { status, pdfUrl, error } = body as Record<string, unknown>;
+
+  if (status === "ready" && typeof pdfUrl === "string" && pdfUrl.length <= 2000 && isAllowedPdfUrl(pdfUrl)) {
+    return { status: "ready", pdfUrl };
+  }
+  if (status === "failed") {
+    return { status: "failed", failureReason: typeof error === "string" ? error.slice(0, 500) : "unknown error" };
+  }
+  return null;
+}
+
+export async function POST(request: Request, ctx: RouteContext<"/api/quotes/[id]/callback">) {
+  const { id } = await ctx.params;
+  const token = request.headers.get("authorization")?.match(/^Bearer (\S+)$/)?.[1];
+  const quote = await db.getQuote(id);
+
+  // One answer for an unknown quote and a wrong token, so ids cannot be probed.
+  if (!token || !quote || !verifyCallbackToken(token, quote.callbackTokenHash)) {
+    return Response.json({ error: "unauthorized" }, { status: 401 });
+  }
+
+  const raw = await request.text();
+  if (raw.length > MAX_BODY_LENGTH) {
+    return Response.json({ error: "payload too large" }, { status: 413 });
+  }
+
+  let body: unknown;
+  try {
+    body = JSON.parse(raw);
+  } catch {
+    return Response.json({ error: "invalid json" }, { status: 400 });
+  }
+
+  const result = parseResult(body);
+  if (!result) {
+    return Response.json({ error: "expected { status: 'ready', pdfUrl } or { status: 'failed', error }" }, { status: 400 });
+  }
+
+  if (result.status === "failed") {
+    console.error(`quote-request workflow failed for ${id}: ${result.failureReason}`);
+  }
+
+  // Idempotent: a retried callback for a quote that is already ready is a no-op.
+  await db.settleQuote(id, result);
+  return Response.json({ ok: true });
+}
